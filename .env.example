# ==============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO (.env.example) - ms-auth
# ==============================================================================
# Copia este archivo como .env y completa los valores correspondientes:
# cp .env.example .env

# Puerto del microservicio
SERVER_PORT=8086

# Configuración de Base de Datos MySQL (Docker Compose)
MYSQL_PORT=3307
MYSQL_DATABASE=authdb
MYSQL_ROOT_PASSWORD=tu_password_root_aqui

# Datasource para Spring Boot (ms-auth)
DB_URL=jdbc:mysql://mysql-auth:3306/authdb?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
DB_DRIVER=com.mysql.cj.jdbc.Driver
DB_USERNAME=root
DB_PASSWORD=tu_password_aqui

# Flyway Migrations
FLYWAY_ENABLED=true

# Seguridad JWT
# JWT_SECRET debe tener al menos 256 bits (64 caracteres hexadecimales recomendados)
JWT_SECRET=tu_clave_secreta_super_segura_de_al_menos_256_bits_aqui
# Expiración en milisegundos (86400000 ms = 24 horas)
JWT_EXPIRATION=86400000
